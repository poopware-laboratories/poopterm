diff --color -ruN orig/libtcc.c src/libtcc.c
--- orig/libtcc.c	2026-11-24 11:42:13
+++ src/libtcc.c	2026-11-24 11:42:14
@@ -1281,6 +1281,26 @@
 /* find [cross-]libtcc1.a and tcc helper objects in library path */
 ST_FUNC int tcc_add_support(TCCState *s1, const char *filename)
 {
+#ifdef POOPTERM_RUNTIME_SOURCES
+    /* Poopterm: the helper objects and libtcc1.a are made by running the
+     * tcc just built, which the app never does at build time. Their C
+     * sources (lib/ of the app's tcc folder) are compiled with the program
+     * instead, each time: a few hundred lines. */
+    static const char *const runmain[] = { "runmain.c", 0 };
+    static const char *const libtcc1[] = { "libtcc1.c", "lib-arm64.c", "builtin.c", 0 };
+    const char *const *sources = 0;
+    char path[1024];
+    if (strcmp(filename, "runmain.o") == 0)
+        sources = runmain;
+    else if (strcmp(filename, TCC_LIBTCC1) == 0)
+        sources = libtcc1;
+    for (; sources && *sources; ++sources) {
+        snprintf(path, sizeof path, "%s/lib/%s", s1->tcc_lib_path, *sources);
+        if (tcc_add_file(s1, path) < 0)
+            return -1;
+    }
+    return sources ? 0 : tcc_add_dll(s1, filename, AFF_PRINT_ERROR);
+#endif
     char buf[100];
     if (CONFIG_TCC_CROSSPREFIX[0])
         filename = strcat(strcpy(buf, CONFIG_TCC_CROSSPREFIX), filename);
